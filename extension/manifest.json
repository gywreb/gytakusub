{
  "manifest_version": 3,
  "name": "Gytakusub",
  "version": "1.0.0",
  "description": "Translate manga and comic pages in place on any site, using your own Claude API key. No account, no server.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gytakusub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "translate-visible": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate all images currently on screen"
    },
    "toggle-overlays": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Show / hide translations on this page"
    }
  }
}
